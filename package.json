{
  "name": "@sanity-labs/vellum",
  "version": "0.1.0",
  "description": "Map Markdown into Sanity documents with a classifier instead of a text generator",
  "keywords": [
    "sanity",
    "markdown",
    "portable-text",
    "cms",
    "classifier"
  ],
  "homepage": "https://vellum.sanity.build",
  "bugs": {
    "url": "https://github.com/sanity-labs/vellum/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/vellum.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "browserslist": "extends @sanity/browserslist-config",
  "exports": {
    ".": {
      "source": "./src/sdk.ts",
      "default": "./dist/sdk.js"
    },
    "./server": {
      "source": "./src/api/http.ts",
      "default": "./dist/api/http.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "knip": "knip",
    "format": "biome check --write .",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "build:pkg": "pkg-utils build --strict --check --clean",
    "prepublishOnly": "pnpm build:pkg",
    "release": "changeset publish"
  },
  "dependencies": {
    "@portabletext/markdown": "^2.2.2",
    "@portabletext/schema": "^3.0.0",
    "@sanity/agent-schema": "0.5.0",
    "@sanity/diff-match-patch": "3.2.1",
    "@sanity/schema": "^6.15.0",
    "@sanity/schema-descriptor-utils": "^1.3.1",
    "@sanity/validation": "^6.15.0",
    "markdown-it": "^15.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "knip": "^6.37.0",
    "lucide-react": "^1.47.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1",
  "publishConfig": {
    "exports": {
      ".": "./dist/sdk.js",
      "./server": "./dist/api/http.js",
      "./package.json": "./package.json"
    }
  }
}
