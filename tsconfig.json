{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/app/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
